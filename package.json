{
  "name": "pi-pinned-question",
  "version": "0.1.0",
  "description": "Keep your latest question pinned above the editor in the Pi TUI so it never scrolls away.",
  "type": "module",
  "license": "MIT",
  "author": "fenixc9",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "tui",
    "widget"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fenixc9/pi-pinned-question.git"
  },
  "homepage": "https://github.com/fenixc9/pi-pinned-question#readme",
  "bugs": {
    "url": "https://github.com/fenixc9/pi-pinned-question/issues"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pinned-question.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test test/pinned-question.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/rpc-smoke.mjs",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}